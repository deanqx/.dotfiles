set $mod Mod4
set $alt Mod1

font JetBrainsMono Nerd Font Mono 8

# XDG Portal service has to know which desktop is running
# required for dark mode
include /etc/sway/config.d/*

# exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec_always autotiling-rs

exec waybar
exec foot --server
exec tmux start-server
exec playerctld daemon
exec dunst

set $w1 "1:1"
set $w2 "3:2"
set $w3 "5:3"
set $w4 "7:4"
set $w5 "9:5"
set $wa1 "2:~1"
set $wa2 "4:~2"
set $wa3 "6:~3"
set $wa4 "8:~4"
set $wa5 "10:~5"

assign [class="firefox"] $w1
assign [app_id="emacs"] $w2
assign [class="Signal"] $wa4
assign [class="Spotify"] $wa5

workspace $w1 output DP-4
workspace $w2 output DP-4
workspace $wa4 output DP-0
workspace $wa5 output DP-0

# for Razer devices
exec polychromatic-cli -e Default

# Desktop apps
exec firefox
exec emacs
exec signal-desktop
exec spotify

assign [app_id="firefox"] $w1
assign [app_id="signal"] $wa4
assign [app_id="spotify"] $wa5

workspace $w1 output DP-3
workspace $wa4 output DP-1
workspace $wa5 output DP-1

input * {
    xkb_layout "us"
    # Used for special german chars
    xkb_variant "altgr-intl"
    xkb_options caps:escape
    repeat_delay 300
    repeat_rate 35
}

input "type:touchpad" {
    tap enabled
    natural_scroll disabled # invert scrolling
    dwt disabled # disable while typing
    scroll_factor 0.7
    accel_profile adaptive # adaptive or flat
    pointer_accel 0.5
    click_method clickfinger  # or buttonareas
}

output * {
    # scaling not working correctly with X11 apps
    # scale 1.0666666
    bg $(ls ~/Wallpapers/bg_* | head -n 1) fill
}

output DP-1 {
    pos 0 0
}

output DP-3 {
    pos 2560 0
}

# launch app launcher like dmenu
bindsym $mod+d exec "fuzzel"
# launch terminal
bindsym $mod+t exec "footclient"
# launch file explorer
bindsym $mod+e exec "nautilus"
# lock desktop and suspend
bindsym $mod+x exec "systemctl suspend && swaylock"

# --- Screenshots (https://wiki.archlinux.org/title/Screen_capture#Wayland)
# selection of screen
bindsym Print exec grim -g "$(slurp -b \#ffffff03)" "/home/$USER/Screenshots/$(date --iso-8601=seconds).png"
# whole screen
bindsym Shift+Print exec grim "/home/$USER/Screenshots/$(date --iso-8601=seconds).png"
# selection of screen to clipboard
bindsym Ctrl+Print exec grim -g "$(slurp -b \#ffffff03)" - | wl-copy
# whole screen to clipboard
bindsym Ctrl+Shift+Print exec grim - | wl-copy

# switch audio device
bindsym $mod+a exec --no-startup-id wpctl set-default $(wpctl status | sed -n 's/ │\s*\([0-9]\+\).*Analog Stereo.*/\1/p' | head -n 1)

bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ && $refresh_i3status
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && $refresh_i3status
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# reload the configuration file
bindsym $mod+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Do you really want to exit sway? This will close all open windows.' -B 'Yes, exit sway' 'swaymsg exit'

bindsym $mod+r mode "resize"

# resize window (you can also use the mouse for that)
mode "resize" {
    bindsym Equal resize grow width 5 ppt
    bindsym Minus resize shrink width 5 ppt
    bindsym g resize grow height 5 ppt
    bindsym s resize shrink height 5 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+q kill
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+s move workspace to output right

# switch to workspace
bindsym $mod+1 workspace $w1
bindsym $mod+2 workspace $w2
bindsym $mod+3 workspace $w3
bindsym $mod+4 workspace $w4
bindsym $mod+5 workspace $w5
bindsym $alt+1 workspace $wa1
bindsym $alt+2 workspace $wa2
bindsym $alt+3 workspace $wa3
bindsym $alt+4 workspace $wa4
bindsym $alt+5 workspace $wa5

# move focused container to workspace
bindsym $mod+Control+1 move container to workspace $w1
bindsym $mod+Control+2 move container to workspace $w2
bindsym $mod+Control+3 move container to workspace $w3
bindsym $mod+Control+4 move container to workspace $w4
bindsym $mod+Control+5 move container to workspace $w5
bindsym $alt+Control+1 move container to workspace $wa1
bindsym $alt+Control+2 move container to workspace $wa2
bindsym $alt+Control+3 move container to workspace $wa3
bindsym $alt+Control+4 move container to workspace $wa4
bindsym $alt+Control+5 move container to workspace $wa5

# move focused container to workspace and switch
bindsym $mod+Shift+1 move container to workspace $w1; workspace $w1
bindsym $mod+Shift+2 move container to workspace $w2; workspace $w2
bindsym $mod+Shift+3 move container to workspace $w3; workspace $w3
bindsym $mod+Shift+4 move container to workspace $w4; workspace $w4
bindsym $mod+Shift+5 move container to workspace $w5; workspace $w5
bindsym $alt+Shift+1 move container to workspace $wa1; workspace $wa1
bindsym $alt+Shift+2 move container to workspace $wa2; workspace $wa2
bindsym $alt+Shift+3 move container to workspace $wa3; workspace $wa3
bindsym $alt+Shift+4 move container to workspace $wa4; workspace $wa4
bindsym $alt+Shift+5 move container to workspace $wa5; workspace $wa5

