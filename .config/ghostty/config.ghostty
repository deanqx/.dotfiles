font-family = JetBrainsMono Nerd Font Mono
font-size = 12

cursor-style-blink = false
shell-integration-features = no-cursor

foreground = f8f8f2
background = 000000
background-opacity = 0.82
selection-foreground = ffffff
selection-background = 44475a

# Normal colors (0-7)
palette = 0=#21222c
palette = 1=#ff5555
palette = 2=#50fa7b
palette = 3=#f1fa8c
palette = 4=#bd93f9
palette = 5=#ff79c6
palette = 6=#8be9fd
palette = 7=#f8f8f2

# Bright colors (8-15)
palette = 8=#6272a4
palette = 9=#ff6e6e
palette = 10=#69ff94
palette = 11=#ffffa5
palette = 12=#d6acff
palette = 13=#ff92df
palette = 14=#a4ffff
palette = 15=#ffffff