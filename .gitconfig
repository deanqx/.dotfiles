[user]
    email = dean2@kowatsch.de
    name = deanqx
    signingkey = /home/dean/.ssh/main_ed25519.pub
[push]
	autoSetupRemote = true
[credential]
	helper = cache
[init]
	defaultBranch = main
[safe]
	directory = /home/dean/server0/root/registry
[rebase]
	autoStash = true
[diff]
	algorithm = histogram
[rerere]
	enabled = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	program = /home/dean/.local/bin/git-ssh-sign-wrapper.sh
